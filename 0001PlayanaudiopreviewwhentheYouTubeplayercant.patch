+      if (this.yt && this.ytReady) {
+        this.mode = 'youtube';
+        this.ready = true;
+        try {
+          this.yt.loadVideoById(track.sourceId);
+          this.yt.setVolume(Math.round(this.volume * 100));
+          if (autoplay) {
