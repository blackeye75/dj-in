+          this.onYouTubeUnavailable(track);
+        }
+        return;
+      }
+
       try {
         await this.#ensureYouTube();
         this.mode = 'youtube';
@@ -219,7 +241,7 @@ export class PlayerEngine {
           this.#emit();
         }
       } catch (err) {
-        this.onError(err.message || 'YouTube playback unavailable.');
+        this.onYouTubeUnavailable(track, err.message);
       }
       return;
     }
@@ -238,6 +260,18 @@ export class PlayerEngine {
     else this.#emit();
   }
 
+  /**
+   * Build the YouTube player ahead of time so the eventual tap can call
