@@ -207,6 +209,26 @@ export class PlayerEngine {
     }
 
     if (track.source === 'youtube') {
+      // Warm player: start it inside the caller's gesture, with nothing awaited
+      // in between. Building the player first (script fetch + onReady) pushes
