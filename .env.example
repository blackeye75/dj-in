# ---------------------------------------------------------------- database
# MongoDB Atlas connection string. Without it the app runs on an in-memory
# store seeded with the same catalogue — everything works, nothing persists.
MONGODB_URI=
MONGODB_DB=dj_in

# ------------------------------------------------------------ admin access
# Set this to lock /admin writes. The panel sends it as the x-admin-key header.
# Leave empty for an open local demo.
ADMIN_KEY=

# --------------------------------------------------------- music providers
# iTunes Search needs no key and is always on (30 second previews).
# YouTube Data API v3 key — enables YouTube search + full-length playback.
YOUTUBE_API_KEY=

# Spotify client credentials — enables Spotify metadata search. Only tracks
# that still expose a preview_url are playable.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
