From 39a4196f631417785bccd4afff120a9f86802754 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 14 Aug 2026 15:42:00 +0000
Subject: [PATCH] Restore SYNORA branding

The 3-way patch apply conflicted in the stage header and the resolution
dropped this side, reverting the app name. Puts it back and carries it into
the metadata, which never had it.

- Header wordmark: SYN + ORA, the second half in the active theme accent.
- Tagline: reactive music & lighting experience.
- Footer credit and page metadata (title, description, Open Graph).

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018JjAD7WNZmP26cnkvFDZws
---
 app/layout.js | 12 ++++++++++--
 app/page.js   |  6 +++---
 2 files changed, 13 insertions(+), 5 deletions(-)

diff --git a/app/layout.js b/app/layout.js
index 15c549f..a60f744 100644
--- a/app/layout.js
+++ b/app/layout.js
@@ -1,10 +1,18 @@
 import './globals.css';
 
 export const metadata = {
-  title: 'DJ Ramp — Deluxe Salon Light Desk',
+  title: 'SYNORA — Reactive Music & Lighting Experience',
   description:
-    'A bus-salon DJ ramp: moving heads, PAR cans, lasers, strobes and fog on a live control desk, with a themed music player, queue, lyrics and search. Made by Priyanshu Raj.',
+    'A reactive music and lighting experience: moving heads, PAR cans, lasers, strobes and fog on a live control desk, with a themed music player, queue, lyrics and search. Made by Priyanshu Raj.',
   authors: [{ name: 'Priyanshu Raj' }],
+  applicationName: 'SYNORA',
+  openGraph: {
+    title: 'SYNORA — Reactive Music & Lighting Experience',
+    description:
+      'Six themed scenes, a full stage rig you can operate, and a music deck with queue, search and timed lyrics.',
+    siteName: 'SYNORA',
+    type: 'website',
+  },
 };
 
 export const viewport = {
diff --git a/app/page.js b/app/page.js
index 836ce27..9ba21f0 100644
--- a/app/page.js
+++ b/app/page.js
@@ -127,10 +127,10 @@ function StageSection() {
